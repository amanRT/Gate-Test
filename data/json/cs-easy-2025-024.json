 "questions": [
  {
   "n": 1,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE & IT • +1 / -0.33",
   "html": "<p>Which of the following statement is FALSE?</p>",
   "options": [
    {
     "key": "A",
     "html": "All recursive sets are recursively enumerable."
    },
    {
     "key": "B",
     "html": "The complement of every recursively enumerable sets is recursively enumerable."
    },
    {
     "key": "C",
     "html": "Every Non-empty recursively enumerable set is the range of some totally recursive function."
    },
    {
     "key": "D",
     "html": "All finite sets are recursive."
    }
   ],
   "answer": [
    "B"
   ],
   "natRange": null,
   "answerText": "B",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(b)<br />\nThe complement of every recursively enumerable sets is recursively enumerable.<br />\nBecause RE language are not closed under complement.</p>"
  },
  {
