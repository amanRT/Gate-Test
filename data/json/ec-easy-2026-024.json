  {
   "n": 6,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • ELECTRONICS ENGINEERING • +1 / -0.33",
   "html": "<p>Which of the following is not an application of a gray code?</p>",
   "options": [
    {
     "key": "A",
     "html": "It is used in transmission of digital signal."
    },
    {
     "key": "B",
     "html": "It is generally used in angle measurement devices."
    },
    {
     "key": "C",
     "html": "It is generally used for arithmetic operation."
    },
    {
     "key": "D",
     "html": "It is generally used as a position indicator."
    }
   ],
   "answer": [
    "C"
   ],
   "natRange": null,
   "answerText": "C",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(c)<br />\n&bull; Gray Code is a binary code where two successive values differ in only one bit. It is used in<br />\ntransmission of digital signal as it reduces occurrence of error.<br />\n&bull; The cyclic property of gray code makes it useful for angle measurement.<br />\n&bull; It is generally used as a position indicator as two successive values differ in only one bit.<br />\n&bull; Gray code does not use positional weighting, making it unsuitable for arithmetic operations.</p>"
  },
