     "html": "Colpitts oscillator"
    },
    {
     "key": "B",
     "html": "Wien bridge oscillator"
    },
    {
     "key": "C",
     "html": "Hartley oscillator"
    },
    {
     "key": "D",
     "html": "None of the these"
    }
   ],
   "answer": [
    "C"
   ],
   "natRange": null,
   "answerText": "C",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>\n\t(c)<br />\n\tIn Hartley Oscillator, <em>X</em><sub>1</sub> and <em>X</em><sub>2</sub> are inductors and <em>X</em><sub>3</sub> is a capacitor and in the Colpitts oscillator, <em>X</em><sub>1</sub> and <em>X</em><sub>2</sub> are capacitors and <em>X</em><sub>3</sub> is an inductor.</p>"
  },
