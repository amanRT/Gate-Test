  {
   "n": 1,
   "type": "MCQ",
   "section": "Technical",
   "tags": "",
   "html": "<p>A flip-flop can be constructed from two NAND gates connected as follows:<br>\n<strong><img alt=\"\" height=\"174\" src=\"media/52/5220cc15567d528a3851.png\" width=\"323\"></strong><br>\nWhat restriction must be placed on $S$ and $R$ so that $P$ always equals $Q'? $</p>",
   "paragraph": null,
   "options": [
    {
     "key": "A",
     "html": "<p>we do not allow the $R=S=0$ state.</p>"
    },
    {
     "key": "B",
     "html": "<p>we do not allow the $R=S=1$ state.</p>"
    },
    {
     "key": "C",
     "html": "<p>we do not allow the $R=0, S=1$ state.</p>"
    },
    {
     "key": "D",
     "html": "<p>$P$ is always equal to $Q’$ regardless of the inputs $S,P.$</p>"
    }
   ],
   "answer": [
    "A"
   ],
   "natRange": null,
   "answerText": "A",
   "marks": {
    "pos": 1,
    "neg": 0.3333
   },
   "solution": "<p><strong>Answer:</strong> A</p><p><a href=\"https://gateoverflow.in/376254\" target=\"_blank\" rel=\"noopener\">Official discussion page</a></p>"
  },
