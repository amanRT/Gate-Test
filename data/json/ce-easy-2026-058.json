  {
   "n": 15,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • CIVIL ENGINEERING • +1 / -0.33",
   "html": "<p>Prying forces are the additional</p>",
   "options": [
    {
     "key": "A",
     "html": "shearing forces on the bolts because of long joint"
    },
    {
     "key": "B",
     "html": "bending forces on the bolts because of long joint"
    },
    {
     "key": "C",
     "html": "forces due to friction between the connected parts"
    },
    {
     "key": "D",
     "html": "tensile forces due to the flexibility of connected parts leading to deformations."
    }
   ],
   "answer": [
    "D"
   ],
   "natRange": null,
   "answerText": "D",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(d)<br />\nPrying forces are additional tensile stresses that develop in bolts when the connected components<br />\nare not perfectly rigid and flex under load, causing the bolts to experience increased tension<br />\nbeyond the initial preload.</p>"
  },
