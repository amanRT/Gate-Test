  {
   "n": 4,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • MECHANICAL ENGINEERING • +1 / -0.33",
   "html": "<p>Which one of the following statement is FALSE for streamlines in a steady incompressible flow?</p>",
   "options": [
    {
     "key": "A",
     "html": "Stream function has a constant value along a streamline."
    },
    {
     "key": "B",
     "html": "Two streamlines cannot intersect each other."
    },
    {
     "key": "C",
     "html": "Converging straight streamlines pattern indicates convective normal acceleration in the flow direction."
    },
    {
     "key": "D",
     "html": "Tangent drawn at any point on a streamline represents the direction of the instantaneous velocity at that point."
    }
   ],
   "answer": [
    "C"
   ],
   "natRange": null,
   "answerText": "C",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(c)<br />\nConverging straight streamlines pattern indicates convective tangential deceleration in the flow direction.</p>"
  },
