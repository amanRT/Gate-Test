  {
   "n": 24,
   "type": "MSQ",
   "section": "Technical",
   "tags": "multi | Marks +1",
   "html": "<p>Consider the following statements about equipotential surface and choose the correct statements:</p>",
   "options": [
    {
     "key": "A",
     "html": "<p>Work done by tangential component of E-field on equipotential surface is zero.</p>"
    },
    {
     "key": "B",
     "html": "<p>Work done by normal component of E-field on equipotential surface is zero.</p>"
    },
    {
     "key": "C",
     "html": "<p>E-field and equipotential surface intersect each other at 90&deg;.</p>"
    },
    {
     "key": "D",
     "html": "<p>Normal component of E-field on equipotential surface is zero.</p>"
    }
   ],
   "answer": [
    "A",
    "C"
   ],
   "natRange": null,
   "answerText": "A, C",
   "marks": {
    "pos": 1,
    "neg": 0
   },
   "solution": "<p>Properties of Equipotential surface (EPS)<br>(i) Tangential component of E-field on EPS is zero.<br>(ii) Normal component of E-field on EPS is non-zero.<br>(iii) E-field and EPS intersect each other at 90&deg;<br>(iv) Perfect conductor behaves as EPS.</p>"
  },
