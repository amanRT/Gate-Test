  {
   "n": 7,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • ELECTRONICS ENGINEERING • +2 / -0",
   "html": "<p>\n\tWhich of the below statements are correct regarding electromagnetic theory?</p>",
   "options": [
    {
     "key": "A",
     "html": "Electric field intensity at any point is the negative of the potential gradient at that point."
    },
    {
     "key": "B",
     "html": "Electric field due to a finite line charge at a point is independent of the length of the line charge."
    },
    {
     "key": "C",
     "html": "The direction of the electrostatic potential gradient at a point is opposite to the direction of the electric field at that point."
    },
    {
     "key": "D",
     "html": "Electric field due to an infinite line of charge at a point is inversely proportional to the square of the distance of the point from the line charge."
    }
   ],
   "answer": [
    "A",
    "C"
   ],
   "natRange": null,
   "answerText": "A, C",
   "marks": {
    "pos": 2,
