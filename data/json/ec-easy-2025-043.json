 "questions": [
  {
   "n": 1,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • ELECTRONICS ENGINEERING • +1 / -0.33",
   "html": "<p>The bandwidth required for the frequency modulated signal is<br />\n(Assume <em>f<sub>m</sub></em> is the maximum frequency present in the message signal)</p>",
   "options": [
    {
     "key": "A",
     "html": "<p>\n\t(β + 1)2 <em>f<sub>m</sub></em></p>"
    },
    {
     "key": "B",
     "html": "<p>\n\t2 <em>f<sub>m</sub></em></p>"
    },
    {
     "key": "C",
     "html": "<p>\n\t<em>f<sub>m</sub></em></p>"
    },
    {
     "key": "D",
     "html": "infinite"
    }
   ],
   "answer": [
    "D"
   ],
   "natRange": null,
   "answerText": "D",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(d)<br />\n&bull; Ideally, for frequency modulated signal, requirement of bandwidth is infinite.<br />\n&bull; The bandwidth required to obtain the most significant sidebands in the FM signal is given by Carson&rsquo;s rule as BW = (&beta; + 1)2<em>f<sub>m</sub></em>.<br />\nSince, here nothing is mentioned. Therefore by default we assume for ideal case. Hence, option (d) is correct.</p>"
  },
  {
   "n": 2,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • ELECTRONICS ENGINEERING • +1 / -0.33",
