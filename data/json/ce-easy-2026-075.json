  {
   "n": 7,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • CIVIL ENGINEERING • +1 / -0.33",
   "html": "<p>Which of the following options is incorrect in reference to matrix method of structure analysis?</p>",
   "options": [
    {
     "key": "A",
     "html": "Elements of leading diagonal of stiffness matrix can be negative"
    },
    {
     "key": "B",
     "html": "Elements of main diagonal of flexibility matrix are always positive."
    },
    {
     "key": "C",
     "html": "Flexibility matrix and its transpose are equal."
    },
    {
     "key": "D",
     "html": "Stiffness matrix is a symmetric matrix."
    }
   ],
   "answer": [
    "A"
   ],
   "natRange": null,
   "answerText": "A",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(a)<br />\n&bull; Flexibility stiffnes matrix is equal to its transpose (<em>A</em>&prime; = A symmetric matrix) as it is a square matrix and its elements are symmetrical about main diagonal.<br />\n&bull; Elements of main diagonal (leading diagonal) of stiffness/flexibility matrix are always positive.</p>"
  },
