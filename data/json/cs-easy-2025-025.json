 "questions": [
  {
   "n": 1,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE & IT • +1 / -0.33",
   "html": "<p>Let 〈M〉 be the encoding of a Turing Machine as a string over Σ = {0, 1}.<br />\nLet <img align=\"absmiddle\" alt=\"\" src=\"media/f7/f7890f37a89b0ce461a4.png\" /> is a Turing Machine that accepts a string of length 2014}. Then <em>L</em> is:</p>\n\n<p> </p>",
   "options": [
    {
     "key": "A",
     "html": "decidable and recursively enumerable"
    },
    {
     "key": "B",
     "html": "undecidable but recursively enumerable"
    },
    {
     "key": "C",
     "html": "undecidable and not recursively enumerable"
    },
    {
     "key": "D",
     "html": "decidable but not recursively enumerable"
    }
   ],
   "answer": [
    "B"
   ],
   "natRange": null,
   "answerText": "B",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(b)</p>\n\n<p><img alt=\"\" src=\"media/d5/d5c4916508c80c363c3b.png\" /></p>"
  },
