  {
   "n": 9,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE & IT • +1 / -0",
   "html": "<p>Which of the following statements about regular languages are true?</p>",
   "options": [
    {
     "key": "A",
     "html": "Regular languages are closed under intersection."
    },
    {
     "key": "B",
     "html": "Regular languages are closed under union."
    },
    {
     "key": "C",
     "html": "Regular languages are closed under complement."
    },
    {
     "key": "D",
     "html": "Regular languages are closed under Kleene operation."
    }
   ],
   "answer": [
    "A",
    "B",
    "C",
    "D"
   ],
   "natRange": null,
   "answerText": "A, B, C, D",
   "marks": {
    "pos": 1,
    "neg": 0
   },
   "solution": "<p>(a, b, c, d)<br />\n&bull; Option (a) regular languages are closed under intersection.<br />\n&bull; Option (b) regular languages are closed under union.<br />\n&bull; Option (c) regular languages are closed under complement.<br />\n&bull; Option (d) regular languages are closed under Kleene operation.</p>"
  },
