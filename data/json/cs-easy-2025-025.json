   ],
   "answer": [
    "A",
    "B",
    "C",
    "D"
   ],
   "natRange": null,
   "answerText": "A, B, C, D",
   "marks": {
    "pos": 2,
    "neg": 0.66
   },
   "solution": "<p>(a)<br />\n(a) 2024 steps in finite. So it is decidable.<br />\n(b) Membership problem of a TM is undecidable.<br />\n(c) Membership problem of a TM is undecidable.<br />\n(d) It is non-trivial property. Hence undecidable.</p>"
  },
