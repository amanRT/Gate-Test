     "html": "{{10}, {10, 20, 30, 41}, {52, 59, 60}}"
    },
    {
     "key": "C",
     "html": "{{10}, {20}, {30}, {41}, {52}, {59}, {60}}"
    },
    {
     "key": "D",
     "html": "{{10, 20}, {30, 41}, {52}, {59, 60}}"
    }
   ],
   "answer": [
    "A",
    "C",
    "D"
   ],
   "natRange": null,
   "answerText": "A, C, D",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>\n\t(a, c, d)<br />\n\tA partition of a set <em>S</em> is a collection of disjoint non-empty subsets of <em>S</em> that have <em>S</em> as their union. For partition in (b) {10} and {10, 20, 30, 41} are not disjoint and hence is not correct partition.</p>"
  },
