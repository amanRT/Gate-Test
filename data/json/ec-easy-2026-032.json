   "answerText": "8.072",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>8.072 (7.8 - 8.2)</p>\n\n<div>&nbsp;</div>\n\n<div><img alt=\"\" src=\"media/c6/c6dd0d97017ede754fbc.png\" /></div>\n\n<div><img alt=\"\" src=\"media/e1/e1ff4ec1d9859783259c.png\" /></div>\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>"
