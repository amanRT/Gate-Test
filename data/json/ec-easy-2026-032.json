    },
    {
     "key": "B",
     "html": "(ii) and (iii) only"
    },
    {
     "key": "C",
     "html": "(i) and (iii) only"
    },
    {
     "key": "D",
     "html": "(i), (ii) and (iii)"
    }
   ],
   "answer": [
    "D"
