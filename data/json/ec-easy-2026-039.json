  {
   "n": 9,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • ELECTRONICS ENGINEERING • +1 / -0",
   "html": "<p>Select the correct option(s) regarding clipper circuits:</p>",
   "options": [
    {
     "key": "A",
     "html": "Clipper circuits serve to protect circuit from damage as a result of over-voltage condition."
    },
    {
     "key": "B",
     "html": "Clipper circuits are also known as D.C. restorer."
    },
    {
     "key": "C",
     "html": "Clipper circuits are also called wave shaping circuits."
    },
    {
     "key": "D",
     "html": "Clipper circuits cannot be designed by using op-amps."
    }
   ],
   "answer": [
    "A",
    "C"
   ],
   "natRange": null,
   "answerText": "A, C",
   "marks": {
    "pos": 1,
    "neg": 0
   },
   "solution": "<p>(a, c)<br />\n&bull; Clipping circuits are wave shaping circuits, used to clip off the portions of an input waveform.<br />\nThey can be used to limit the amplitude of a waveform to a certain level, thus protecting<br />\ncircuit from damage as a result of over-voltage condition.<br />\n&bull; Clipper circuits can also be designed using op-amps.<br />\n&bull; Clamper circuits are known as D.C. restorer as they adjust the DC level of the waveform.<br />\nThus, options (a) and (c) are correct.</p>"
  },
