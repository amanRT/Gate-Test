  {
   "n": 10,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • CIVIL ENGINEERING • +1 / -0",
   "html": "<p>Which of the following statements are correct regarding Influence line diagram?</p>",
   "options": [
    {
     "key": "A",
     "html": "The ILD for reaction, SF or BM is linear for determinate structures and combination of straight line and curve for indeterminate structures"
    },
    {
     "key": "B",
     "html": "For a UDL shorter than span, the maximum bending moment at any section occurs when the section divides load in same ratio as it divides the span."
    },
    {
     "key": "C",
     "html": "For simply supported beam, ILD for BM at any section is triangular"
    },
    {
     "key": "D",
     "html": "For simply supported beam, ILD for SF at any section is rectangular"
    }
   ],
   "answer": [
    "A",
    "B",
    "C"
   ],
   "natRange": null,
   "answerText": "A, B, C",
   "marks": {
    "pos": 1,
    "neg": 0
   },
   "solution": "<p>(a, b, c)<br />\nThe ILD for reaction, SF or BM is linear for determinate structure and combination of straight<br />\nline and curve for indeterminate structures.<br />\nFor a UDL shorter than span, the maximum bending moment at any section will be when the<br />\nsection divides load in same ratio as it divides the span.<br />\nFor simply supported beam, ILD for BM at any section is triangular and ILD for SF is triangular.</p>\n\n<div>&nbsp;</div>\n\n<div><img alt=\"\" src=\"media/e2/e213cb27bc464bef524e.png\" /></div>"
  },
