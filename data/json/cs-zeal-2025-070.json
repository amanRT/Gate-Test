   "solution": "<p>&nbsp;<img style=\"font-family: var(--font-family);\" src=\"media/2a/2abc73bb9fd052735f3d.png\" alt=\"\" /></p>\n<p><img src=\"media/c4/c45fd377e37dee9703a9.png\" alt=\"\" /></p>",
