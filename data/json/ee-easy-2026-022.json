     "key": "B",
     "html": "<em>BC</em>"
    },
    {
     "key": "C",
     "html": "<em>CD</em>"
    },
    {
     "key": "D",
     "html": "<em>DE</em>"
    }
   ],
   "answer": [
    "C"
   ],
   "natRange": null,
   "answerText": "C",
   "marks": {
    "pos": 1,
    "neg": 0.33
   },
   "solution": "<p>(c)<br />\n&bull; Boundary <em>AB</em> is the maximum limit for dc and continous current.<br />\n&bull; Boundary <em>BC</em> is as to limit the junction temperature to safe value.<br />\n&bull; Boundary <em>CD</em> is secondary breakdown limit.<br />\n&bull; Boundary <em>DE</em> is is maximum voltage capability.</p>"
  },
