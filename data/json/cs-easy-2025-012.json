   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE • +2 / -0",
   "html": "<p>\n\tWhich of the following statements is/are correct?</p>",
   "options": [
    {
     "key": "A",
     "html": "The intersection of two recursive enumerable language is recursive enumerable."
    },
    {
     "key": "B",
     "html": "Recursive enumerable languages closed under union and complements."
    },
    {
     "key": "C",
     "html": "Recursive language is closed under positive closure."
    },
    {
     "key": "D",
     "html": "Recursive language is closed under inverse homomorphism."
    }
   ],
   "answer": [
    "A",
    "C",
    "D"
   ],
   "natRange": null,
   "answerText": "A, C, D",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>\n\t(a, c, d)<br />\n\t&bull; Recursive enumerable languages are closed under union and intersections. But not complement.<br />\n\t&bull; Recursive language are closed under positive closure and inverse homomorphism.</p>"
