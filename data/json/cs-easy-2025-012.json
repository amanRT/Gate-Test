   "html": "<p>\n\tWhich of the following problem are decidable?<br />\n\t<strong>I.</strong> Equivalence problem in recursive enumerable languages.<br />\n\t<strong>II.</strong> Co-finiteness problem in deterministic context free language.<br />\n\t<strong>III.</strong> Intersection finiteness problem in Turing Machine.<br />\n\t<strong>IV.</strong> Subset problem in regular language.</p>",
   "options": [
    {
     "key": "A",
     "html": "I and II"
    },
    {
     "key": "B",
     "html": "II only"
    },
    {
     "key": "C",
     "html": "III and IV"
    },
    {
     "key": "D",
     "html": "I and III"
    }
   ],
   "answer": [
    "B"
   ],
   "natRange": null,
   "answerText": "B",
   "marks": {
    "pos": 2,
    "neg": 0.66
   },
   "solution": "<p>\n\t(b)<br />\n\t&bull; Equivalence problem is undecidable problem in REL.<br />\n\t&bull; Co-finiteness problem is decidable problem in DCFL.<br />\n\t&bull; Intersection finiteness problem is undecidable problem in TM.<br />\n\t&bull; Subset problem is a undecidable problem in regular language.</p>"
  },
