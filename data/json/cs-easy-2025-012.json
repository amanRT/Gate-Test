  {
   "n": 17,
   "type": "MCQ",
   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE • +2 / -0.66",
   "html": "<p>\n\tWhich of the following statements are correct?</p>",
   "options": [
    {
     "key": "A",
     "html": "Emptyness property of a DCFL is not decidable."
    },
    {
     "key": "B",
     "html": "Finiteness property of a CFL is not decidable."
    },
    {
     "key": "C",
     "html": "The union of two deterministic context free language is deterministic context free."
    },
    {
     "key": "D",
     "html": "The complement of a deterministic context free language is recursive."
    }
   ],
   "answer": [
    "D"
   ],
   "natRange": null,
   "answerText": "D",
   "marks": {
    "pos": 2,
    "neg": 0.66
   },
   "solution": "<p>\n\t(d)<br />\n\t&bull; Emptyness property of DCFL is decidable.<br />\n\t&bull; Finiteness property of CFL is decidable.<br />\n\t&bull; DCFL is not closed under union.<br />\n\t&bull; DCFL are closed under complement, hence recursive too.</p>"
  },
