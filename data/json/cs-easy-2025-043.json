  {
   "n": 7,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • COMPUTER SCIENCE • +2 / -0",
   "html": "<p>Which of the following statements is/are correct regarding Master Slave JK flip flop?</p>",
   "options": [
    {
     "key": "A",
     "html": "Master flip-flop responds to positive edge of clock."
    },
    {
     "key": "B",
     "html": "Slave flip-flop responds to negative edge of clock."
    },
    {
     "key": "C",
     "html": "It helps in avoiding the race around condition in JK flip flop"
    },
    {
     "key": "D",
     "html": "Output change only during positive edge transition of the clock."
    }
   ],
   "answer": [
    "A",
    "B",
    "C"
   ],
   "natRange": null,
   "answerText": "A, B, C",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>(a, b, c)<br />\nOutput of Master Slave JK flip flop change only during negative edge transition of the clock.</p>"
  },
