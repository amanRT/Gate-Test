  {
   "n": 4,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • Data Science & Artificial Intelligence • +2 / -0",
   "html": "<p>Which of the following statements is/are correct?</p>",
   "options": [
    {
     "key": "A",
     "html": "The eigen value of skew-symmetric matrix [<em>A<sup>T</sup></em> = –<em>A</em>] are purely real."
    },
    {
     "key": "B",
     "html": "The eigen value of skew-symmetric matrix [<em>A<sup>T</sup></em> = –<em>A</em>] are purely imaginary or zero."
    },
    {
     "key": "C",
     "html": "The eigen value of symmetric matrix [<em>A<sup>T</sup></em> = <em>A</em>] are purely imaginary."
    },
    {
     "key": "D",
     "html": "The eigen value of symmetric matrix [<em>A<sup>T</sup></em> = <em>A</em>] are purely real."
    }
   ],
   "answer": [
    "B",
    "D"
   ],
   "natRange": null,
   "answerText": "B, D",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>(b, d)<br />\n&bull; The eigen value of symmetric matrix [<em>A<sup>T</sup></em> = <em>A</em>] are purely real.<br />\n&bull; The eigen value of skew-symmetric matrix [<em>A<sup>T</sup></em> = &ndash;<em>A</em>] are either imaginary or zeros.</p>"
  },
