     "key": "A",
     "html": "<em>AB</em> have atmost n linearly independent vectors."
    },
    {
     "key": "B",
     "html": "<em>BA</em> can be invertible, having non-zero determinant."
    },
    {
     "key": "C",
     "html": "<em>BA</em> have greater then n non-zero eigen values."
    },
    {
     "key": "D",
     "html": "Both <em>AB</em> and <em>BA</em> have equal non-zero eigen values."
    }
   ],
   "answer": [
    "A",
    "D"
   ],
   "natRange": null,
   "answerText": "A, D",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>(a, d)<br />\n&there4; <em>AB</em> and BA have same non-zero eigen values.<br />\n&there4; <em>AB</em> have rank atmost <em>n</em>, so <em>n</em> LI vectors possible.<br />\n&there4; <em>BA</em> have greater than equal two (<em>m</em> &ndash; <em>n</em>) zero eigen values.</p>"
  },
