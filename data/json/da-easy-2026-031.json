  {
   "n": 6,
   "type": "MSQ",
   "section": "Technical",
   "tags": "Technical • Data Science & Artificial Intelligence • +2 / -0",
   "html": "<p>Which of the following statements is/are correct?</p>",
   "options": [
    {
     "key": "A",
     "html": "Lists can be modified after creation."
    },
    {
     "key": "B",
     "html": "Tuples can be modified after creation."
    },
    {
     "key": "C",
     "html": "In a tuple, heterogeneous objects are allowed."
    },
    {
     "key": "D",
     "html": "In, a list, we can increase and decrease the size."
    }
   ],
   "answer": [
    "A",
    "C",
    "D"
   ],
   "natRange": null,
   "answerText": "A, C, D",
   "marks": {
    "pos": 2,
    "neg": 0
   },
   "solution": "<p>(a, c, d)<br />\n&bull; Lists are mutable, contents can be modified after creation by adding, removing, or changing elements.<br />\n&bull; Tuples are immutable, once they are created, their contents cannot be changed, including<br />\nadding, removing, or modifying elements.<br />\n&bull; Tuples can contain heterogeneous objects.<br />\n&bull; A list is dynamic in size.</p>"
  },
